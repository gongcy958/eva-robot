# Runtime
LLM_PROVIDER=openai_compatible
LLM_PROFILE=default
LLM_DEFAULT_MODEL=gpt-5.1
LLM_HIGH_QUALITY_MODEL=gpt-5.2
LLM_BASE_URL=https://gmncode.cn
LLM_API_KEY=your_api_key_here
LLM_PREFLIGHT_PROBE=true
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b-instruct
LOG_LEVEL=INFO
SKIP_STARTUP_CHECKS=false

# Voice
WAKE_WORD=伊娃
SLEEP_COMMAND=退下吧
ASR_LANGUAGE=auto
ASR_RETRIES=2
CONVERSATION_MEMORY_TURNS=3
