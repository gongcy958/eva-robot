# Runtime
LLM_PROVIDER=openai_compatible
LLM_PROFILE=default
LLM_DEFAULT_MODEL=gpt-5.1-2025-11-13
LLM_HIGH_QUALITY_MODEL=gpt-5.4
LLM_BASE_URL=https://gmncode.cn
LLM_API_KEY=your_api_key_here
LLM_PREFLIGHT_PROBE=true
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b-instruct
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/eva_robot.jsonl
SKIP_STARTUP_CHECKS=false

# Voice
WAKE_WORD=伊娃
WAKE_ACK_MESSAGE=我在。
INLINE_WAKE_ACK_MESSAGE=
SLEEP_COMMAND=退下吧
SLEEP_ACK_MESSAGE=好的，我先待命。
ASR_LANGUAGE=auto
ASR_RETRIES=2
ASR_MIN_AVG_LOGPROB=-1.2
ASR_MAX_NO_SPEECH_PROB=0.7
ASR_LOW_CONFIDENCE_MESSAGE=抱歉，我没太听清，请再说一遍。
ASR_SECOND_PASS_LANGUAGE=en
ASR_SECOND_PASS_MIN_LANGUAGE_PROBABILITY=0.65
ASR_SECOND_PASS_DISABLE_VAD=true
ECHO_FILTER_WINDOW_SECONDS=3.0
ECHO_FILTER_MIN_SIMILARITY=0.72
ECHO_FILTER_MIN_CHARS=12
CONVERSATION_MEMORY_TURNS=3
SPEECH_START_CHUNKS=3
PREROLL_DURATION_SECONDS=0.3
AMBIENT_NOISE_SECONDS=0.4
SPEECH_START_THRESHOLD_MULTIPLIER=2.2
SPEECH_END_THRESHOLD_MULTIPLIER=1.6
FOLLOWUP_COOLDOWN_SECONDS=0.6
